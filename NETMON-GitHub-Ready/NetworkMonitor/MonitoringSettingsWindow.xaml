<Window x:Class="NetworkMonitor.MonitoringSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoring Settings"
        Height="430"
        Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Monitoring Settings"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Configure how NETMON monitors your registered devices."
                       Foreground="#718096"
                       FontSize="12"
                       Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,15">

            <StackPanel>
                <TextBlock Text="AUTOMATIC CHECK INTERVAL"
                           Foreground="#52637A"
                           FontWeight="Bold"
                           FontSize="11"
                           Margin="0,0,0,10"/>

                <ComboBox x:Name="IntervalComboBox"
                          Height="38"
                          Padding="8"
                          Background="#F8FAFC"
                          Foreground="#172B4D"
                          BorderBrush="#D8E1EE"
                          SelectedIndex="2">

                    <ComboBoxItem Content="10 seconds" Tag="10"/>
                    <ComboBoxItem Content="15 seconds" Tag="15"/>
                    <ComboBoxItem Content="30 seconds" Tag="30"/>
                    <ComboBoxItem Content="60 seconds" Tag="60"/>
                    <ComboBoxItem Content="120 seconds" Tag="120"/>

                </ComboBox>

                <TextBlock Text="Choose how frequently registered devices are checked."
                           Foreground="#718096"
                           FontSize="11"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">

            <StackPanel>
                <TextBlock Text="MONITORING STATUS"
                           Foreground="#52637A"
                           FontWeight="Bold"
                           FontSize="11"/>

                <TextBlock x:Name="StatusText"
                           Text="Monitoring active"
                           Foreground="#16A36A"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,10,0,12"/>

                <Button x:Name="PauseResumeButton"
                        Content="Pause Monitoring"
                        Height="38"
                        Background="#E8F1FF"
                        Foreground="#2563EB"
                        BorderBrush="#D6E5FF"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Click="PauseResume_Click"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="Note: Pausing monitoring stops automatic checks. You can resume monitoring at any time."
                   Foreground="#718096"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="2,15"/>

        <Button Grid.Row="4"
                Content="Save Settings"
                Height="40"
                Background="#2563EB"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                Click="SaveSettings_Click"/>
    </Grid>
</Window>
