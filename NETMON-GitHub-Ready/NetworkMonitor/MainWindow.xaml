<Window x:Class="NetworkMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Monitor | Control Center"
        Height="850"
        Width="1450"
        MinHeight="750"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Window.Resources>

        <!-- COLOURS -->
        <SolidColorBrush x:Key="AccentBrush" Color="#246BFD"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7B879A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#17243A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5EAF2"/>

        <!-- NAVIGATION BUTTONS -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#EDF3FF"/>
                                <Setter Property="Foreground"
                                        Value="#246BFD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CARDS -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E5EAF2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#246BFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1554D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#E5EAF2"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="17">

                <!-- BRAND -->
                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal"
                                Margin="5,8,0,5">

                        <Border Background="#246BFD"
                                CornerRadius="8"
                                Width="35"
                                Height="35">
                            <TextBlock Text="N"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="NETMON"
                                       Foreground="#17243A"
                                       FontSize="19"
                                       FontWeight="Bold"/>
                            <TextBlock Text="NETWORK SECURITY"
                                       Foreground="#246BFD"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </StackPanel>

                    </StackPanel>

                    <Border Height="1"
                            Background="#E9EDF4"
                            Margin="0,23,0,23"/>

                    <TextBlock Text="MAIN MENU"
                               Foreground="#94A0B2"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,0,0,10"/>

                    <Button Content="▦    Dashboard"
                            Style="{StaticResource NavButton}"
                            Background="#EAF1FF"
                            Foreground="#246BFD"
                            Click="Dashboard_Click"/>

                    <Button Content="◉    Network Devices"
                            Style="{StaticResource NavButton}"
                            Click="Devices_Click"/>

                    <Button Content="⌘    Network Topology"
                            Style="{StaticResource NavButton}"
                            Click="Topology_Click"/>

                    <Button Content="↗    Network Traffic"
                            Style="{StaticResource NavButton}"
                            Click="Traffic_Click"/>

                    <Button Content="⚠    Alerts &amp; Events"
                            Style="{StaticResource NavButton}"
                            Click="Alerts_Click"/>

                    <Button Content="▤    Reports"
                            Style="{StaticResource NavButton}"
                            Click="Reports_Click"/>

                    <TextBlock Text="CONFIGURATION"
                               Foreground="#94A0B2"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,30,0,10"/>

                    <Button Content="⚙    Settings"
                            Style="{StaticResource NavButton}"
                            Click="Settings_Click"/>

                </StackPanel>

                <!-- SYSTEM STATUS -->
                <Border DockPanel.Dock="Bottom"
                        Background="#F0F6FF"
                        BorderBrush="#DCE8FF"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="13"
                        Margin="0,15,0,0">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#16B978"
                                     Margin="0,0,8,0"/>

                            <TextBlock Text="SYSTEM ONLINE"
                                       Foreground="#246BFD"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <TextBlock Text="Network monitoring is ready"
                                   Foreground="#75849B"
                                   FontSize="10"
                                   Margin="16,7,0,0"/>

                    </StackPanel>
                </Border>

            </DockPanel>
        </Border>

        <!-- MAIN DASHBOARD -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP HEADER -->
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E5EAF2"
                    BorderThickness="0,0,0,1">

                <Grid Margin="27,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Network Monitor"
                                   Foreground="#17243A"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text=" / "
                                   Foreground="#B0BAC9"
                                   Margin="8,0"/>

                        <TextBlock Text="Dashboard"
                                   Foreground="#7B879A"
                                   FontSize="13"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Background="#F0F6FF"
                                CornerRadius="7"
                                Padding="12,8">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#16B978"
                                         Margin="0,0,8,0"/>

                                <TextBlock Text="SYSTEM ONLINE"
                                           Foreground="#246BFD"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- SCROLLABLE CONTENT -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="28">

                    <!-- PAGE TITLE -->
                    <Grid Margin="0,0,0,25">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock x:Name="PageTitle"
                                       Text="Network Dashboard"
                                       Foreground="#17243A"
                                       FontSize="26"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="PageSubtitle"
                                       Text="Monitor your network infrastructure and device activity."
                                       Foreground="#8795A8"
                                       FontSize="12"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="↻   REFRESH"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center"
                                Click="Refresh_Click"/>

                    </Grid>

                    <!-- STATISTICS CARDS -->
                    <UniformGrid Columns="4"
                                 Margin="0,0,0,22">

                        <!-- TOTAL DEVICES -->
                        <Border Style="{StaticResource PanelCard}"
                                Margin="0,0,12,0">

                            <StackPanel>

                                <TextBlock Text="TOTAL DEVICES"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="DevicesCountText"
                                           Text="0"
                                           Foreground="#17243A"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Margin="0,13,0,5"/>

                                <TextBlock Text="Configured devices"
                                           Foreground="#8795A8"
                                           FontSize="10"/>

                                <Border Height="4"
                                        Background="#246BFD"
                                        CornerRadius="3"
                                        Margin="0,17,0,0"/>

                            </StackPanel>
                        </Border>

                        <!-- ONLINE -->
                        <Border Style="{StaticResource PanelCard}"
                                Margin="0,0,12,0">

                            <StackPanel>

                                <TextBlock Text="DEVICES ONLINE"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="OnlineCountText"
                                           Text="0"
                                           Foreground="#16A36A"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Margin="0,13,0,5"/>

                                <TextBlock Text="Currently reachable"
                                           Foreground="#8795A8"
                                           FontSize="10"/>

                                <Border Height="4"
                                        Background="#16B978"
                                        CornerRadius="3"
                                        Margin="0,17,0,0"/>

                            </StackPanel>
                        </Border>

                        <!-- OFFLINE -->
                        <Border Style="{StaticResource PanelCard}"
                                Margin="0,0,12,0">

                            <StackPanel>

                                <TextBlock Text="DEVICES OFFLINE"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="OfflineCountText"
                                           Text="0"
                                           Foreground="#E99A32"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Margin="0,13,0,5"/>

                                <TextBlock Text="Currently unreachable"
                                           Foreground="#8795A8"
                                           FontSize="10"/>

                                <Border Height="4"
                                        Background="#F2A541"
                                        CornerRadius="3"
                                        Margin="0,17,0,0"/>

                            </StackPanel>
                        </Border>

                        <!-- ALERTS -->
                        <Border Style="{StaticResource PanelCard}">

                            <StackPanel>

                                <TextBlock Text="TOTAL ALERTS"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="AlertsCountText"
                                           Text="0"
                                           Foreground="#E05252"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Margin="0,13,0,5"/>

                                <TextBlock Text="Events requiring review"
                                           Foreground="#8795A8"
                                           FontSize="10"/>

                                <Border Height="4"
                                        Background="#E05252"
                                        CornerRadius="3"
                                        Margin="0,17,0,0"/>

                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- ANALYTICS PANELS -->
                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- NETWORK ACTIVITY -->
                        <Border Grid.Column="0"
                                Style="{StaticResource PanelCard}"
                                Margin="0,0,12,0">

                            <StackPanel>

                                <TextBlock Text="NETWORK ACTIVITY"
                                           Foreground="#17243A"
                                           FontSize="14"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Traffic monitoring overview"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           Margin="0,5,0,18"/>

                                <Grid Height="145">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="DOWNLOAD"
                                                   Foreground="#8795A8"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="DownloadText"
                                                   Text="Not connected"
                                                   Foreground="#246BFD"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,9,0,0"/>

                                        <TextBlock Text="Incoming traffic"
                                                   Foreground="#A0AABC"
                                                   FontSize="10"
                                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="UPLOAD"
                                                   Foreground="#8795A8"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="UploadText"
                                                   Text="Not connected"
                                                   Foreground="#5485E8"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,9,0,0"/>

                                        <TextBlock Text="Outgoing traffic"
                                                   Foreground="#A0AABC"
                                                   FontSize="10"
                                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                </Grid>

                                <Border Background="#EDF3FF"
                                        Height="5"
                                        CornerRadius="3"/>

                            </StackPanel>
                        </Border>

                        <!-- MONITORING STATUS -->
                        <Border Grid.Column="1"
                                Style="{StaticResource PanelCard}">

                            <StackPanel>

                                <TextBlock Text="MONITORING STATUS"
                                           Foreground="#17243A"
                                           FontSize="14"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Application information"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           Margin="0,5,0,18"/>

                                <TextBlock Text="MONITORING ENGINE"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="EngineStatusText"
                                           Text="Ready"
                                           Foreground="#16A36A"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Margin="0,6,0,16"/>

                                <TextBlock Text="LAST DASHBOARD UPDATE"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="LastUpdateText"
                                           Text="Waiting..."
                                           Foreground="#17243A"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>

                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- RECENT EVENTS -->
                    <Border Style="{StaticResource PanelCard}"
                            Margin="0,0,0,20">

                        <DockPanel>

                            <StackPanel DockPanel.Dock="Top"
                                        Margin="0,0,0,17">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="RECENT NETWORK EVENTS"
                                               Foreground="#17243A"
                                               FontSize="14"
                                               FontWeight="Bold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="LIVE ACTIVITY"
                                               Foreground="#246BFD"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                </Grid>

                                <TextBlock Text="Application activity and monitoring messages"
                                           Foreground="#8795A8"
                                           FontSize="10"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <ListBox x:Name="EventsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#34445C"
                                     FontSize="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MinHeight="160"
                                     MaxHeight="250">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Background" Value="#F7F9FC"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBoxItem Content="System initialized. Waiting for device configuration."
                                             Padding="8"/>

                                <ListBoxItem Content="Network monitoring dashboard loaded."
                                             Padding="8"/>

                                <ListBoxItem Content="No devices have been configured yet."
                                             Padding="8"/>

                            </ListBox>

                        </DockPanel>
                    </Border>

                    <!-- FOOTER -->
                    <TextBlock Text="NETMON  |  NETWORK MONITORING SYSTEM"
                               Foreground="#A0AABC"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,15"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
