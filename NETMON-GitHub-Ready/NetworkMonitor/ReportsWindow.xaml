<Window x:Class="NetworkMonitor.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Reports"
        Height="750"
        Width="1150"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Network Reports"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Review monitoring statistics and export your network activity."
                       Foreground="#718096"
                       FontSize="13"
                       Margin="0,7,0,0"/>
        </StackPanel>

        <!-- STATISTICS -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,20">

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="TOTAL DEVICES"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TotalDevicesText"
                               Text="0"
                               Foreground="#172B4D"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="ONLINE"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="OnlineDevicesText"
                               Text="0"
                               Foreground="#16A36A"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="OFFLINE"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="OfflineDevicesText"
                               Text="0"
                               Foreground="#DC5262"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="TOTAL ALERTS"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TotalAlertsText"
                               Text="0"
                               Foreground="#2563EB"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="HIGH SEVERITY"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="HighAlertsText"
                               Text="0"
                               Foreground="#DC5262"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ALERT HISTORY -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Alert History"
                           Foreground="#172B4D"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"/>

                <DataGrid x:Name="ReportsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="White"
                          Foreground="#334155"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="#EDF1F7"
                          CanUserResizeRows="False"
                          SelectionMode="Single">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#EFF4FA"/>
                            <Setter Property="Foreground" Value="#52637A"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time"
                                            Binding="{Binding Timestamp}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Device"
                                            Binding="{Binding DeviceName}"
                                            Width="130"/>

                        <DataGridTextColumn Header="IP Address"
                                            Binding="{Binding IPAddress}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Severity"
                                            Binding="{Binding Severity}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding InvestigationStatus}"
                                            Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- EXPORT BUTTONS -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Refresh Report"
                    Width="130"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#E8F1FF"
                    Foreground="#2563EB"
                    BorderBrush="#D6E5FF"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Click="RefreshReport_Click"/>

            <Button Content="Export CSV"
                    Width="130"
                    Height="38"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="ExportCsv_Click"/>
        </StackPanel>

    </Grid>
</Window>
