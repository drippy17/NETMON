<Window x:Class="NetworkMonitor.TrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Traffic Monitor"
        Height="800"
        Width="1150"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Network Traffic Monitor"
                       Foreground="#172B4D"
                       FontSize="27"
                       FontWeight="Bold"/>

            <TextBlock Text="Live bandwidth statistics from your computer's network adapter."
                       Foreground="#718096"
                       FontSize="13"
                       Margin="0,7,0,0"/>
        </StackPanel>

        <!-- ADAPTER CONTROLS -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="NETWORK ADAPTER"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="AdapterComboBox"
                              Height="38"
                              Padding="8"
                              Background="#F8FAFC"
                              Foreground="#172B4D"
                              BorderBrush="#D8E1EE"
                              SelectionChanged="AdapterComboBox_SelectionChanged"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="REFRESH ADAPTERS"
                        Padding="13,10"
                        Margin="0,21,8,0"
                        Background="#E8F1FF"
                        Foreground="#2563EB"
                        BorderBrush="#D6E5FF"
                        BorderThickness="1"
                        Click="RefreshAdapters_Click"/>

                <Button Grid.Column="2"
                        Content="START"
                        Width="90"
                        Padding="12,10"
                        Margin="0,21,8,0"
                        Background="#16A36A"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="Start_Click"/>

                <Button Grid.Column="3"
                        Content="STOP"
                        Width="90"
                        Padding="12,10"
                        Margin="0,21,0,0"
                        Background="#DC5262"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="Stop_Click"/>
            </Grid>
        </Border>

        <!-- LIVE STATISTICS -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,20">

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="DOWNLOAD SPEED"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="DownloadSpeedText"
                               Text="0.00 Mbps"
                               Foreground="#2563EB"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="UPLOAD SPEED"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="UploadSpeedText"
                               Text="0.00 Mbps"
                               Foreground="#7C3AED"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOTAL DOWNLOADED"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TotalDownloadedText"
                               Text="0 MB"
                               Foreground="#172B4D"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="TOTAL UPLOADED"
                               Foreground="#718096"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="TotalUploadedText"
                               Text="0 MB"
                               Foreground="#172B4D"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- BANDWIDTH GRAPH -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="LIVE BANDWIDTH GRAPH"
                                   Foreground="#172B4D"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Download and upload speed over time"
                                   Foreground="#718096"
                                   FontSize="11"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#2563EB"
                                 Margin="0,0,6,0"/>

                        <TextBlock Text="Download"
                                   Foreground="#52637A"
                                   FontSize="11"
                                   Margin="0,0,15,0"/>

                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#7C3AED"
                                 Margin="0,0,6,0"/>

                        <TextBlock Text="Upload"
                                   Foreground="#52637A"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="#F8FAFF"
                        BorderBrush="#E8EEF7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">

                    <Canvas x:Name="TrafficCanvas"
                            Background="#F8FAFF"
                            ClipToBounds="True"/>
                </Border>

                <TextBlock x:Name="MonitoringStatusText"
                           Grid.Row="2"
                           Text="Monitoring stopped"
                           Foreground="#718096"
                           FontSize="11"
                           Margin="0,12,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
