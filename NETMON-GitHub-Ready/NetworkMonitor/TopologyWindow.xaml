<Window x:Class="NetworkMonitor.TopologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Topology | NETMON"
        Height="750"
        Width="1150"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#246BFD"/>
        <SolidColorBrush x:Key="TextBrush" Color="#17243A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8795A8"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#246BFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1554D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,23">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Network Topology"
                           Foreground="#17243A"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="Visual representation of your configured network devices."
                           Foreground="#8795A8"
                           FontSize="12"
                           Margin="0,7,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="#EAF1FF"
                    CornerRadius="8"
                    Padding="13,9"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="#246BFD"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="NETWORK MAP"
                               Foreground="#246BFD"
                               FontSize="10"
                               FontWeight="Bold"/>

                </StackPanel>
            </Border>

        </Grid>

        <!-- NETWORK SUMMARY -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5EAF2"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel Margin="0,0,25,0">
                        <TextBlock Text="CONFIGURED DEVICES"
                                   Foreground="#8795A8"
                                   FontSize="9"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="DeviceCountText"
                                   Text="0"
                                   Foreground="#17243A"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Width="1"
                            Height="35"
                            Background="#E5EAF2"
                            Margin="0,0,20,0"/>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="#16B978"
                                 Margin="0,0,8,0"/>

                        <TextBlock Text="Online"
                                   Foreground="#526178"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="#E05252"
                                 Margin="0,0,8,0"/>

                        <TextBlock Text="Offline"
                                   Foreground="#526178"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="↻  REFRESH MAP"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"
                        Click="RefreshMap_Click"/>

            </Grid>
        </Border>

        <!-- NETWORK MAP -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E5EAF2"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- MAP HEADER -->
                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="#E9EDF4"
                        BorderThickness="0,0,0,1"
                        Padding="18,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="NETWORK VISUALIZATION"
                                       Foreground="#17243A"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Connected devices and their current availability"
                                       Foreground="#8795A8"
                                       FontSize="10"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="TOPOLOGY VIEW"
                                   Foreground="#246BFD"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                    </Grid>
                </Border>

                <!-- CANVAS -->
                <Canvas x:Name="NetworkCanvas"
                        Grid.Row="1"
                        Background="#F8FAFF"
                        ClipToBounds="True"/>

            </Grid>
        </Border>

    </Grid>
</Window>
